# ─────────────────────────────────────────────────────────────────────────────
# DukaanVoice PK — environment variables
#
# EVERY value here is OPTIONAL. The register and the Munshi AI agent run fully
# offline / on-device without any of these. Each key simply *upgrades* a specific
# capability; if it is missing, a local fallback is used automatically.
#
# Copy to `.env.local` and fill in only what you have.
# ─────────────────────────────────────────────────────────────────────────────

# ── Gemma / Ollama (the agent's LLM) ────────────────────────────────────────
# Two ways to provide the model — either works, and both fall back to a
# deterministic parser if unreachable:
#   (a) LOCAL Ollama:  `ollama pull gemma2:2b && ollama serve`
#   (b) OLLAMA CLOUD (no install): set OLLAMA_API_KEY and use the /api/generate
#       URL below with a cloud model such as gemma4:31b-cloud.
# OLLAMA_TIMEOUT_MS raises the request budget for larger models.
OLLAMA_API_URL=http://localhost:11434/api/generate
GEMMA_MODEL_NAME=gemma2:2b
# OLLAMA_API_KEY=
# OLLAMA_TIMEOUT_MS=15000

# ── Prior Labs TabPFN (tabular foundation model) ────────────────────────────
# Sign up at https://platform.priorlabs.ai (free non-commercial license).
# When set, demand forecasting runs on the live TabPFN API (upload -> fit ->
# predict, see https://docs.priorlabs.ai/api/rest-quickstart). With no key, no
# network, or too little sales history, the on-device heuristic runs instead and
# the result marks its source. Model path: v3.5_default (or v3.5-fast_default).
TABPFN_API_KEY=
TABPFN_MODEL_PATH=v3.5_default

# ── SerpApi (live wholesale / mandi rate grounding) ─────────────────────────
# https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# ── ElevenLabs (multilingual voice) ─────────────────────────────────────────
# https://elevenlabs.io — falls back to the browser Web Speech API when absent.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── Sentry (agent tracing) ──────────────────────────────────────────────────
# When set, every Munshi agent span is forwarded to Sentry Agent Tracing.
# When absent, spans are still captured in the in-app Agent Trace panel.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Mastra (open-source agent orchestration) ────────────────────────────────
# The same shop tools are exposed through Mastra so any model-router provider
# can drive them. Defaults to Ollama Cloud when OLLAMA_API_KEY is set (provider
# `ollama-cloud`, base https://ollama.com/v1), otherwise the local Ollama Gemma.
# Any other provider works too, e.g. `openai/gpt-4o-mini`.
# MASTRA_MODEL=ollama-cloud/gemma4:31b
